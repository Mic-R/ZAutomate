#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BUNDLE_LIB_DIR="$SCRIPT_DIR/../@CMAKE_INSTALL_LIBDIR@"
BUNDLE_BIN_DIR="$SCRIPT_DIR/../@CMAKE_INSTALL_LIBDIR@/zautomate-bin"
SYMLINK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/zautomate-qt-XXXXXX")

cleanup() {
	rm -rf "$SYMLINK_DIR"
}

trap cleanup EXIT HUP INT TERM

for lib in "$BUNDLE_LIB_DIR"/lib*.so.*; do
	[ -e "$lib" ] || continue
	base=$(basename -- "$lib")
	if command -v readelf >/dev/null 2>&1; then
		soname=$(readelf -d "$lib" 2>/dev/null | sed -n 's/.*Library soname: \[\(.*\)\].*/\1/p' | head -n 1)
	fi
	soname=${soname:-$(printf '%s\n' "$base" | sed -E 's/^(.+\.so\.[0-9]+)\..*$/\1/')}
	[ "$soname" != "$base" ] || continue
	if [ ! -e "$SYMLINK_DIR/$soname" ]; then
		ln -s "$lib" "$SYMLINK_DIR/$soname"
	fi
	unset soname
done

export LD_LIBRARY_PATH="$SYMLINK_DIR:$BUNDLE_LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$BUNDLE_LIB_DIR/qt6/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
export QT_QPA_PLATFORM_PLUGIN_PATH="$BUNDLE_LIB_DIR/qt6/plugins/platforms"

install_xcb_deps() {
	if ! command -v apt-get >/dev/null 2>&1; then
		printf '%s\n' "ZAutomate needs Ubuntu Qt/xcb platform dependencies." >&2
		printf '%s\n' "Install them with: sudo apt-get install libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 libxcb-xinerama0 libxkbcommon-x11-0" >&2
		return 1
	fi

	printf '%s\n' "ZAutomate needs Ubuntu Qt/xcb platform dependencies." >&2
	packages="libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 libxcb-xinerama0 libxkbcommon-x11-0"

	if [ "$(id -u)" = "0" ]; then
		apt-get update && apt-get install -y $packages
		return $?
	fi

	if [ -t 0 ] && command -v sudo >/dev/null 2>&1; then
		printf '%s' "Install missing Qt/xcb packages now? [y/N] " >&2
		read answer || answer=
		case "$answer" in
			y|Y|yes|YES)
				sudo apt-get update && sudo apt-get install -y $packages
				return $?
				;;
		esac
	fi

	if command -v pkexec >/dev/null 2>&1; then
		printf '%s\n' "Requesting permission to install Qt/xcb packages..." >&2
		pkexec /bin/sh -c "apt-get update && apt-get install -y $packages"
		return $?
	fi

	printf '%s\n' "Install them with: sudo apt-get install $packages" >&2
	return 1
}

XCB_PLUGIN="$QT_QPA_PLATFORM_PLUGIN_PATH/libqxcb.so"
xcb_ready=0
if [ -f "$XCB_PLUGIN" ] && command -v ldd >/dev/null 2>&1; then
	xcb_ldd=$(ldd "$XCB_PLUGIN" 2>/dev/null || true)
	if printf '%s\n' "$xcb_ldd" | grep -q 'not found'; then
		printf '%s\n' "ZAutomate detected missing Qt/xcb dependencies:" >&2
		printf '%s\n' "$xcb_ldd" | grep 'not found' >&2 || true
		install_xcb_deps || true
		xcb_ldd=$(ldd "$XCB_PLUGIN" 2>/dev/null || true)
	fi
	if ! printf '%s\n' "$xcb_ldd" | grep -q 'not found'; then
		xcb_ready=1
	fi
	unset xcb_ldd
fi

if [ -z "${QT_QPA_PLATFORM:-}" ]; then
	if [ "$xcb_ready" = "1" ]; then
		export QT_QPA_PLATFORM=xcb
	elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
		export QT_QPA_PLATFORM=wayland
	fi
fi
unset xcb_ready

exec "$BUNDLE_BIN_DIR/zautomate" "$@"
