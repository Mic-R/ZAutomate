#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export LD_LIBRARY_PATH="$SCRIPT_DIR/../@CMAKE_INSTALL_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$SCRIPT_DIR/../@CMAKE_INSTALL_LIBDIR@/qt6/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
export QT_QPA_PLATFORM_PLUGIN_PATH="$SCRIPT_DIR/../@CMAKE_INSTALL_LIBDIR@/qt6/plugins/platforms"

exec "$SCRIPT_DIR/../@CMAKE_INSTALL_LIBEXECDIR@/zautomate/zautomate" "$@"
